{
    "name": "heimseiten/contao-cta-at-the-side-bundle",
    "description": "Fügt Call To Action Buttons an einer Seite hinzu",
    "keywords": [
        "sticky",
        "fixed",
        "kontakt"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "heimseiten.de - Webdesign aus Köln",
            "email": "info@heimseiten.de",
            "homepage": "https://www.heimseiten.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/heimseiten/contao-cta-at-the-side-bundle/issues",
        "source": "https://github.com/heimseiten/contao-cta-at-the-side-bundle"
    },
    "require": {
        "contao/core-bundle": "^4.9 | ^5.1"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Heimseiten\\ContaoCtaAtTheSideBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Heimseiten\\ContaoCtaAtTheSideBundle\\ContaoManager\\Plugin"
    }
}
